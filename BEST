.discuss{border:1px solid var(--line);border-radius:10px;padding:12px 14px;font-weight:600;line-height:20px}
@media (prefers-reduced-motion:reduce){.shake,.pop .bigheart,.pop .like,.spin{animation:none}.bar i,.prog i,.toast{transition:none}}
</style>
</head>
