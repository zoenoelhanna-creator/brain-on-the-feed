<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>*,*::before,*::after{box-sizing:border-box}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>Brain on the Feed</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gochi+Hand&family=DM+Serif+Display:ital@1&display=swap">
<style>
/* Layout: the app (nav rail + endless feed) is always a white screen; the brain and activity panel sits
   beside it on a contrasting grey that follows the viewer's theme. */
:root{
  /* the app itself: always light, like a phone screen */
  --app-bg:#FFFFFF; --app-fg:#000000; --app-soft:#737373; --app-line:#DBDBDB; --app-hover:#F2F2F2;
  --link:#0095F6; --heart:#FF3040;
  /* the info panel around it */
  --bg:#E8EBF0; --card:#FFFFFF; --fg:#15171C; --soft:#5E6470; --line:#D3D8E0; --elev:#E3E6EB;
  --overlay:rgba(12,14,18,.6); --toast:#15171C; --toast-fg:#FFFFFF;
  /* chemicals and post art */
  --pink:#FF48B0; --orange:#FF6C2F; --yellow:#FFE600; --teal:#00838A; --blue:#0078BF; --gold:#C9A227; --lime:#7BE041; --purple:#7C4DDB; --ink:#111111;
  --ui:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --hand:"Gochi Hand","Comic Sans MS","Marker Felt",cursive;
  --serif:"DM Serif Display",Georgia,serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0E0F12; --card:#1B1D22; --fg:#F1F2F4; --soft:#A2A7B0; --line:#2C2F36; --elev:#2C2F36;
  --overlay:rgba(0,0,0,.75); --toast:#F1F2F4; --toast-fg:#000000; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0E0F12; --card:#1B1D22; --fg:#F1F2F4; --soft:#A2A7B0; --line:#2C2F36; --elev:#2C2F36;
  --overlay:rgba(0,0,0,.75); --toast:#F1F2F4; --toast-fg:#000000; color-scheme:dark}
body{background:var(--bg);color:var(--fg);font-family:var(--ui);font-size:14px;line-height:18px}
button,input{font:inherit;color:inherit}
svg.i{width:24px;height:24px;flex:0 0 auto;display:block}

/* ---------- the app: left rail ---------- */
.rail{position:fixed;left:0;top:0;bottom:0;width:244px;border-right:1px solid var(--app-line);background:var(--app-bg);color:var(--app-fg);z-index:5;
  padding:calc(env(safe-area-inset-top,0px) + 8px) 12px calc(env(safe-area-inset-bottom,0px) + 20px);display:flex;flex-direction:column;gap:2px}
.wm{font-weight:700;font-size:24px;letter-spacing:-.045em;line-height:1}
.rail .wm{padding:26px 12px 22px}
.rail .wm .short{display:none}
.item{all:unset;box-sizing:border-box;display:flex;align-items:center;gap:16px;padding:12px;border-radius:8px;font-size:16px;line-height:20px;position:relative}
.item.on{font-weight:700}
button.item{cursor:pointer}
.item:hover{background:var(--app-hover)}
.item:focus-visible{outline:2px solid var(--link)}
.rail .grow{flex:1}
.me{width:24px;height:24px;border-radius:50%;background:var(--blue);color:#fff;font-size:9px;font-weight:700;display:grid;place-items:center;flex:0 0 auto}
.dot{position:absolute;width:8px;height:8px;border-radius:50%;background:var(--heart);border:2px solid var(--app-bg)}
.item .dot{left:30px;top:9px}
@media (max-width:1263px){.rail{width:72px}.rail .lbl{display:none}.rail .wm .full{display:none}.rail .wm .short{display:block;font-size:26px}.rail .wm{padding:26px 12px 22px 14px}}
@media (max-width:999px){.rail{display:none}}

/* ---------- the app: mobile chrome ---------- */
.mtop,.crewbar,.mbot{display:none}
@media (max-width:999px){
  .mtop{display:flex;position:sticky;top:0;z-index:5;background:var(--app-bg);color:var(--app-fg);border-bottom:1px solid var(--app-line);align-items:center;justify-content:space-between;padding:calc(env(safe-area-inset-top,0px) + 10px) 16px 10px;gap:16px}
  .mtop .r{display:flex;align-items:center;gap:16px}
  .mtop .ic{position:relative}
  .mtop .dot{right:-3px;top:-2px}
  .mtop .count{color:var(--app-soft);font-size:13px;font-variant-numeric:tabular-nums}
  .crewbar{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;position:sticky;top:calc(env(safe-area-inset-top,0px) + 49px);z-index:4;background:var(--bg);color:var(--fg);border-bottom:1px solid var(--line);padding:8px 12px}
  .cb{display:grid;justify-items:center;gap:3px;min-width:0;text-align:center}
  .cb .av{width:30px;height:30px}
  .cb b{font-size:10px;overflow-wrap:anywhere;font-weight:600;line-height:13px}
  .cb b span{font-weight:400;color:var(--soft);font-variant-numeric:tabular-nums}
  .cb .bar{width:80%}
  .mbot{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:5;background:var(--app-bg);color:var(--app-fg);border-top:1px solid var(--app-line);justify-content:space-around;align-items:center;padding:10px 8px calc(env(safe-area-inset-bottom,0px) + 10px)}
}
.linkbtn{all:unset;cursor:pointer;color:var(--link);font-weight:600;font-size:14px}
.linkbtn:hover{opacity:.7}
.linkbtn:focus-visible{outline:2px solid var(--link);outline-offset:2px}

/* ---------- columns ---------- */
main{display:flex;min-height:100vh}
@media (max-width:999px){body{background:var(--app-bg)}}
.feedwrap{flex:1;min-width:0;background:var(--app-bg);color:var(--app-fg);display:flex;justify-content:center;padding-inline:16px;padding-block:22px 80px}
.feedcol{width:100%;max-width:470px;min-width:0}
@media (max-width:999px){.feedwrap{padding-top:8px}}

.apphead{display:flex;justify-content:space-between;align-items:center;padding:4px 4px 18px}
.apphead .r{display:flex;gap:20px;align-items:center}
.apphead .ic{position:relative}
.apphead .dot{right:-3px;top:-2px}
@media (max-width:999px){.apphead{display:none}}
/* stories */
.stories{display:flex;gap:16px;padding:4px 0 16px;overflow-x:auto;scrollbar-width:none;margin-bottom:8px}
.stories::-webkit-scrollbar{display:none}
.story{display:grid;justify-items:center;gap:5px;width:66px;flex:0 0 auto}
.ring{width:66px;height:66px;border-radius:50%;padding:2px;background:linear-gradient(45deg,var(--blue),var(--pink))}
.ring.seen{background:var(--app-line)}
.ring span{width:100%;height:100%;border-radius:50%;border:3px solid var(--app-bg);display:grid;place-items:center;font-weight:700;font-size:15px;color:#fff}
.story small{font-size:12px;max-width:66px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* posts */
.ig{border-bottom:1px solid var(--app-line);padding-bottom:16px;margin-bottom:12px}
.ig-h{display:flex;align-items:center;gap:10px;padding:0 4px 12px}
.pav{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:700;font-size:12px;flex:0 0 auto}
.ig-h .n{min-width:0;line-height:18px}
.ig-h b{font-weight:600}
.ig-h .t{color:var(--app-soft)}
.ig-h small{display:block;font-size:12px;line-height:16px}
.ig-h .more{margin-left:auto}
.media{all:unset;container-type:inline-size;box-sizing:border-box;display:block;width:100%;aspect-ratio:1/1;max-width:100%;position:relative;cursor:pointer;overflow:hidden;border-radius:4px;border:1px solid var(--app-line);user-select:none}
@media (max-width:999px){.media{border-radius:0;border-inline:0}}
.media:focus-visible{outline:3px solid var(--link);outline-offset:-3px}
.bigheart{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;opacity:0}
.bigheart svg{width:96px;height:96px;filter:drop-shadow(0 4px 12px rgba(0,0,0,.35))}
.pop .bigheart{animation:pop .75s ease both}
@keyframes pop{0%{opacity:0;transform:scale(.3)}25%{opacity:1;transform:scale(1.15)}45%{transform:scale(.95)}75%{opacity:1;transform:scale(1)}100%{opacity:0}}
.actions{display:flex;align-items:center;gap:16px;padding:8px 2px 6px;position:relative}
.actions button{all:unset;cursor:pointer;display:grid;place-items:center}
.actions button:hover{opacity:.55}
.actions button:focus-visible{outline:2px solid var(--link);outline-offset:3px;border-radius:4px}
.liked .like path{fill:var(--heart);stroke:var(--heart)}
.pop .like{animation:tap .3s ease}
@keyframes tap{50%{transform:scale(1.25)}}
.actions .save{margin-left:auto}
.cdots{position:absolute;left:50%;transform:translateX(-50%);display:flex;gap:4px}
.cdots i{width:6px;height:6px;border-radius:50%;background:#A8A8A8;opacity:.6}
.cdots i:first-child{background:var(--link);opacity:1}
.ig p{margin:0;padding:0 2px}
.ig .likes{font-weight:600;font-variant-numeric:tabular-nums;margin-top:2px}
.ig .cap{margin-top:6px}
.ig .cap b{font-weight:600}
.ig .vc,.ig .add{color:var(--app-soft);margin-top:6px}

.caught{display:grid;justify-items:center;gap:6px;text-align:center;padding:28px 16px 30px;border-bottom:1px solid var(--app-line);margin-bottom:16px}
.caught svg{width:72px;height:72px}
.caught b{font-size:18px;line-height:24px;font-weight:600}
.caught span{color:var(--app-soft)}
.caught .linkbtn{margin-top:6px}
.sugg-h{font-weight:600;font-size:16px;padding:0 4px 14px}
.loading{display:grid;place-items:center;padding:24px}
.spin{width:28px;height:28px;border-radius:50%;border:3px solid var(--app-line);border-top-color:var(--app-soft);animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* post artwork, one look per kind of account */
.art{position:absolute;inset:0;display:grid;padding:26px;text-align:left}
.art.outrage{background:#111;color:#fff;align-content:space-between}
.art.outrage .tag{justify-self:start;background:var(--heart);color:#fff;font:800 12px/1 var(--ui);letter-spacing:.14em;padding:6px 8px}
.art.outrage .hl{font:800 clamp(22px,8cqw,38px)/1.02 var(--ui);text-transform:uppercase;letter-spacing:-.02em}
.art.outrage .src{font:400 12px var(--ui);color:#aaa}
.art.cute{background-color:var(--pink);background-image:radial-gradient(rgba(17,17,17,.18) 1.3px,transparent 1.7px);background-size:7px 7px;color:var(--ink);place-items:center;text-align:center}
.art.cute .hl{font:400 clamp(24px,8.6cqw,42px)/1.05 var(--hand);background:#fff;padding:10px 16px;transform:rotate(-3deg);box-shadow:5px 5px 0 var(--ink);max-width:88%}
.reel{position:absolute;top:12px;right:12px;display:flex;gap:4px;align-items:center;color:#fff;font:600 12px var(--ui);background:rgba(0,0,0,.4);padding:3px 8px;border-radius:12px}
.art.compare{background:linear-gradient(160deg,#F6D9C6 0%,#E9B7A8 45%,#B98C9E 100%);color:#fff;align-content:end}
.art.compare .hl{font:italic 400 clamp(26px,9cqw,44px)/1.02 var(--serif);text-shadow:0 2px 14px rgba(80,30,40,.35)}
.art.compare .sun{position:absolute;right:18%;top:14%;width:34%;aspect-ratio:1;max-width:100%;border-radius:50%;background:radial-gradient(circle,#FFF6E6 0 55%,rgba(255,246,230,0) 70%)}
.art.friends{padding:0}
.art.friends svg{width:100%;height:100%;display:block}
.art.friends .hl{position:absolute;left:16px;bottom:14px;font:700 15px var(--ui);color:#fff;background:rgba(0,0,0,.4);padding:4px 10px;border-radius:14px}
.art.learn{background-color:var(--blue);background-image:linear-gradient(rgba(255,255,255,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.12) 1px,transparent 1px);background-size:22px 22px;color:#fff;align-content:space-between}
.art.learn .num{font:700 13px var(--ui);opacity:.85}
.art.learn .hl{font:800 clamp(24px,8.2cqw,40px)/1.05 var(--ui);letter-spacing:-.02em}
.art.learn .swipe{font:700 13px var(--ui);justify-self:end}


/* brain rot: loud, loud, loud */
.art.rot{background:repeating-linear-gradient(135deg,#7BE041 0 22px,#B36BFF 22px 44px);place-items:center;text-align:center;overflow:hidden}
.art.rot .hl{font:900 clamp(28px,11cqw,56px)/.95 Impact,"Arial Black",var(--ui);text-transform:uppercase;color:#fff;-webkit-text-stroke:2px #000;paint-order:stroke fill;text-shadow:4px 4px 0 #000;max-width:92%;animation:jiggle 1.2s ease-in-out infinite}
@keyframes jiggle{0%,100%{transform:rotate(-3deg) scale(1)}50%{transform:rotate(3deg) scale(1.06)}}
.art.rot .stk{position:absolute;font:900 clamp(12px,3.8cqw,18px)/1 Impact,"Arial Black",var(--ui);color:#000;padding:1.6cqw 2.6cqw;border:2px solid #000;box-shadow:3px 3px 0 #000}
.art.rot .s1{top:6cqw;left:6cqw;transform:rotate(-8deg)}
.art.rot .s2{bottom:7cqw;right:6cqw;transform:rotate(6deg)}
@media (prefers-reduced-motion:reduce){.art.rot .hl{animation:none}}
/* screenshot-style posts */
.art.shot{place-items:center;padding:7cqw}
.sc{background:#fff;color:#0F1419;border-radius:16px;padding:5cqw 5.5cqw;width:100%;box-sizing:border-box;box-shadow:0 10px 30px rgba(0,0,0,.25);font-family:var(--ui);text-align:left}
.tw-h{display:flex;gap:10px;align-items:center}
.tw-av{width:clamp(30px,9cqw,42px);height:clamp(30px,9cqw,42px);border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:700;font-size:13px;flex:0 0 auto}
.tw-h b{display:block;font-size:clamp(13px,3.6cqw,17px);line-height:1.2}
.tw-h small{color:#536471;font-size:clamp(12px,3.2cqw,15px)}
.tw p{margin:3.5cqw 0 !important;padding:0 !important;font-size:clamp(15px,4.7cqw,22px);line-height:1.3}
.tw > small{color:#536471;font-size:clamp(11px,3cqw,14px)}
.q{display:block;font-size:clamp(16px,5cqw,24px);line-height:1.2;margin-bottom:4cqw;letter-spacing:-.01em}
.opt{position:relative;border-radius:8px;overflow:hidden;background:#EFF3F4;display:flex;justify-content:space-between;padding:2.6cqw 3.4cqw;margin-bottom:2.2cqw;font-size:clamp(13px,3.8cqw,18px)}
.opt i{position:absolute;inset:0 auto 0 0;background:#CFD9DE}
.opt.win i{background:#8ECDF8}
.opt span,.opt em{position:relative;font-style:normal}
.opt.win span,.opt.win em{font-weight:700}
.poll > small{color:#536471;font-size:clamp(11px,3cqw,14px)}
.list ol{margin:0;padding-left:1.3em;display:grid;gap:2.4cqw;font-size:clamp(14px,4.3cqw,20px);line-height:1.25}
.list li::marker{font-weight:700}
.chatbg{background:#F2F2F7}
.chat{width:100%;display:flex;flex-direction:column;gap:2.2cqw;font-family:var(--ui)}
.chat-h{display:flex;flex-direction:column;align-items:center;gap:4px;color:#111;font-size:clamp(12px,3.4cqw,15px);margin-bottom:3cqw}
.bub{max-width:76%;padding:2.4cqw 4cqw;border-radius:20px;font-size:clamp(14px,4.4cqw,20px);line-height:1.25}
.bub.l{align-self:flex-start;background:#E5E5EA;color:#000;border-bottom-left-radius:6px}
.bub.r{align-self:flex-end;background:#0B84FF;color:#fff;border-bottom-right-radius:6px}
.art.notes{background:#FFFDF7;color:#1C1C1E;align-content:start;gap:1.6cqw;padding:6cqw 8cqw;font-family:var(--ui)}
.notes-h{color:#D9A400;font-weight:600;font-size:clamp(14px,4cqw,18px);margin-bottom:3cqw}
.art.notes b{font-size:clamp(20px,6.4cqw,30px);margin-bottom:2cqw}
.art.notes span{font-size:clamp(15px,4.6cqw,22px);line-height:1.3}
.rcpt{background:#FAFAF6;color:#111;font-family:"Courier New",ui-monospace,monospace;width:78%;padding:6cqw 6cqw 7cqw;display:grid;gap:1.8cqw;font-size:clamp(12px,3.9cqw,18px);box-shadow:0 10px 30px rgba(0,0,0,.4);transform:rotate(-2deg)}
.rcpt b{text-align:center;letter-spacing:.1em}
.rcpt .dash{border-top:2px dashed #111;margin:1cqw 0}
.rl{display:flex;justify-content:space-between;gap:10px}
.rl.tot{font-weight:700}
.thx{text-align:center;font-size:.8em;margin-top:2cqw}


/* more post formats */
.art.news{background:#fff;color:#111;padding:0;align-content:start;grid-template-rows:auto 1fr auto auto;font-family:var(--ui)}
.nw-top{display:flex;justify-content:space-between;align-items:center;padding:4cqw 5cqw}
.nw-top b{font-family:var(--serif);font-size:clamp(15px,4.6cqw,22px)}
.nw-img{min-height:0;margin:0 5cqw;border-radius:8px}
.nw-t{padding:4cqw 5cqw 1.5cqw;font-size:clamp(17px,5.4cqw,26px);line-height:1.18;letter-spacing:-.01em}
.art.news small{padding:0 5cqw 5cqw;color:#666;font-size:clamp(11px,3.1cqw,14px)}
.cm{padding:5cqw}
.cm-row{display:flex;gap:3cqw;align-items:flex-start}
.cm-row b{font-size:clamp(13px,3.7cqw,17px)}
.cm-t{color:#737373;font-size:clamp(12px,3.3cqw,15px)}
.cm-row p{margin:1.5cqw 0 2cqw !important;padding:0 !important;font-size:clamp(15px,4.8cqw,22px);line-height:1.3}
.cm-row small,.cm-more{color:#737373;font-size:clamp(11px,3.2cqw,14px);font-weight:600}
.cm-more{display:block;margin:3.5cqw 0 0 calc(clamp(30px,9cqw,42px) + 3cqw)}
.art.two{padding:0;grid-template-rows:1fr 1fr}
.art.two > div{display:grid;place-items:center;text-align:center;padding:4cqw 7cqw;position:relative}
.art.two small{position:absolute;top:3.5cqw;left:4.5cqw;font:700 clamp(11px,3.2cqw,14px) var(--ui);text-transform:uppercase;letter-spacing:.06em;opacity:.7}
.art.two span{font:800 clamp(19px,6.4cqw,30px)/1.12 var(--ui);letter-spacing:-.01em}
.art.two .p1{background:#F3EFE6;color:#111}
.art.two .p2{background:#141414;color:#fff}
.art.dump{padding:0;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:2px;background:#fff}
.art.dump > div{position:relative}
.art.dump small{position:absolute;left:3cqw;bottom:3cqw;color:#fff;font:600 clamp(11px,3.2cqw,14px) var(--ui);text-shadow:0 1px 6px rgba(0,0,0,.5)}
.dump-n{position:absolute;top:3cqw;right:3cqw;background:rgba(0,0,0,.55);color:#fff;font:600 12px var(--ui);padding:3px 8px;border-radius:12px}
.art.quote{background:linear-gradient(170deg,#EFE7DA,#D9C8B4);color:#3B2F25;place-content:center;justify-items:center;text-align:center;padding:10cqw}
.qm{font:400 clamp(60px,20cqw,110px)/.6 var(--serif);opacity:.35;height:.5em}
.qt{font:italic 400 clamp(22px,7.2cqw,34px)/1.2 var(--serif)}
.art.quote small{margin-top:5cqw;font:600 clamp(11px,3.2cqw,14px) var(--ui);letter-spacing:.08em;opacity:.7}
.art.ad{padding:0;grid-template-rows:1fr auto;background:linear-gradient(180deg,#FCEFEA,#F4D8CF)}
.ad-stage{display:grid;justify-items:center;align-content:center;gap:2.4cqw;text-align:center;padding:5cqw}
.bottle{position:relative;width:22cqw;height:34cqw;border-radius:5cqw 5cqw 3cqw 3cqw;background:linear-gradient(90deg,#E9A895,#F7CFC2 45%,#E29B86);display:grid;place-items:center;box-shadow:0 8px 20px rgba(120,50,40,.25)}
.bottle i{position:absolute;top:-8cqw;width:9cqw;height:9cqw;border-radius:2cqw 2cqw 0 0;background:#2B2B2B}
.bottle b{font:700 clamp(9px,2.6cqw,12px) var(--ui);color:#5A2E24;letter-spacing:.06em;text-transform:uppercase;writing-mode:vertical-rl;transform:rotate(180deg)}
.ad-t{font:700 clamp(17px,5.4cqw,26px)/1.15 var(--ui);color:#3A1E18;max-width:80%}
.ad-p{font:600 clamp(13px,3.8cqw,17px) var(--ui);color:#7A4A3E}
.cta{display:flex;justify-content:space-between;align-items:center;background:#fff;color:#0095F6;font:600 14px var(--ui);padding:12px 14px;border-top:1px solid #eee}
.cta span{font-size:20px;line-height:1}
.art.ba{padding:0;grid-template-columns:1fr 1fr}
.art.ba > div{display:grid;justify-items:center;align-content:end;gap:3cqw;padding:5cqw 3cqw 7cqw;position:relative}
.art.ba .b{background:#CFCFCF;color:#333}
.art.ba .a{background:linear-gradient(170deg,#FFD2A6,#F08A5D);color:#fff}
.art.ba small{position:absolute;top:4cqw;left:4cqw;font:800 clamp(11px,3.2cqw,14px) var(--ui);letter-spacing:.1em}
.art.ba em{font:700 clamp(14px,4.2cqw,19px) var(--ui);font-style:normal}
