  if(P.k==="notes") return `<div class="art notes"><div class="notes-h">&lsaquo; Notes</div><b>${P.title}</b>${P.lines.map(l=>`<span>${l}</span>`).join("")}</div>`;
  if(P.k==="list") return `<div class="art shot" ${bg}><div class="sc list"><b class="q">${P.title}</b><ol>${P.items.map(t=>`<li>${t}</li>`).join("")}</ol></div></div>`;
  if(P.k==="receipt") return `<div class="art shot" style="background:#2B2B2B"><div class="rcpt"><b>${P.place}</b><span class="dash"></span>${P.lines.map(([a,b])=>`<span class="rl"><span>${a}</span><span>${b}</span></span>`).join("")}<span class="dash"></span><span class="rl tot"><span>TOTAL</span><span>${P.total}</span></span><span class="thx">THANK YOU, COME AGAIN</span></div></div>`;
  if(P.k==="news") return `<div class="art news"><div class="nw-top"><b>${P.outlet}</b><span>&middot;&middot;&middot;</span></div><div class="nw-img" style="background:${BACKDROP[c]}"></div><b class="nw-t">${P.t}</b><small>${P.meta}</small></div>`;
  if(P.k==="comment") return `<div class="art shot" ${bg}><div class="sc cm"><div class="cm-row"><span class="tw-av" style="background:${CATS[c].color}">${initials(P.h)}</span><div><b>${P.h}</b> <span class="cm-t">2d</span><p>${P.t}</p><small>Reply &nbsp;·&nbsp; ${P.likes} likes</small></div></div><small class="cm-more">&mdash;&mdash; View ${P.replies} replies</small></div></div>`;
  if(P.k==="two") return `<div class="art two"><div class="p1"><small>${P.top[0]}</small><span>${P.top[1]}</span></div><div class="p2"><small>${P.bottom[0]}</small><span>${P.bottom[1]}</span></div></div>`;
  if(P.k==="dump"){ const g = ["linear-gradient(150deg,#C79A6B,#6B4A32)","linear-gradient(150deg,#39455C,#1B2130)","linear-gradient(150deg,#E9C46A,#E76F51)","linear-gradient(150deg,#F4A259,#8E5572)","linear-gradient(150deg,#8AB6D6,#2E6B5E)","linear-gradient(150deg,#D8D2C4,#9C8F7A)"];
    return `<div class="art dump">${P.tiles.map((t,i)=>`<div style="background:${g[(i+t.length)%g.length]}"><small>${t}</small></div>`).join("")}<span class="dump-n">1/${P.tiles.length+6}</span></div>`; }
  if(P.k==="quote") return `<div class="art quote"><span class="qm">&ldquo;</span><span class="qt">${P.t}</span><small>${P.by}</small></div>`;
  if(P.k==="ad") return `<div class="art ad"><div class="ad-stage"><span class="bottle"><i></i><b>${P.product}</b></span><span class="ad-t">${P.t}</span><span class="ad-p">${P.price}</span></div><div class="cta">${P.cta}<span>&rsaquo;</span></div></div>`;
  if(P.k==="ba") return `<div class="art ba"><div class="b"><small>BEFORE</small><span class="fig-s"></span><em>${P.before}</em></div><div class="a"><small>AFTER</small><span class="fig-s"></span><em>${P.after}</em></div></div>`;
  return "";
}
function art(c, pic, n){
  if(typeof pic === "object") return shot(c, pic);
  const text = pic;
  if(c==="brainrot"){ const stk = [["+1000 AURA","#FFE600"],["NO CAP","#fff"],["W","#7BE041"],["LOCKED IN","#FF48B0"],["FR FR","#fff"]];
    const a = stk[n%5], b = stk[(n+2)%5];
    return `<div class="art rot"><span class="stk s1" style="background:${a[1]}">${a[0]}</span><span class="hl">${text}</span><span class="stk s2" style="background:${b[1]}">${b[0]}</span></div>`; }
  if(c==="outrage") return `<div class="art outrage"><span class="tag">BREAKING</span><span class="hl">${text}</span><span class="src">Tap to read the full story</span></div>`;
  if(c==="cute") return `<div class="art cute"><span class="reel"><svg viewBox="0 0 24 24" width="12" height="12"><path d="M7 4l13 8-13 8z" fill="#fff"/></svg>0:${10+(n%7)*7}</span><span class="hl">${text}</span></div>`;
  if(c==="compare") return `<div class="art compare"><span class="sun"></span><span class="hl">${text}</span></div>`;
  if(c==="friends"){
    const sky = ["#7EC8E3","#F4A259","#9AD1D4","#C3B1E1","#F7D774"][n%5];
    return `<div class="art friends"><svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><rect width="100" height="100" fill="${sky}"/><circle cx="74" cy="26" r="10" fill="#FFF3C4"/><path d="M0 78 L26 42 L44 66 L62 36 L100 80 V100 H0Z" fill="#2E6B5E"/><path d="M0 88 L30 70 L58 86 L82 72 L100 84 V100 H0Z" fill="#1F4C43"/></svg><span class="hl">${text}</span></div>`;
  }
  return `<div class="art learn"><span class="num">1/6</span><span class="hl">${text}</span><span class="swipe">swipe &rarr;</span></div>`;
}
function pickCat(exclude){
  const keys = Object.keys(CATS).filter(k=>!exclude.includes(k) || Math.random()<.5);
  const ws = keys.map(k=>Math.pow(S.weights[k],1.7)); let r = Math.random()*ws.reduce((a,b)=>a+b,0);
  for(let i=0;i<keys.length;i++){ r-=ws[i]; if(r<=0) return keys[i]; } return keys[keys.length-1];
}
const AGOS = ["12m","1h","3h","5h","1d","2d"];
function postHTML(c){
  const L = POSTS[c].length, idx = S.used[c] % L, loop = Math.floor(S.used[c]/L), p = POSTS[c][idx]; S.used[c]++; S.pid++;
  const nC = parseInt(exact(p[3],loop).replace(/,/g,""),10);
  return `<article class="ig" data-cat="${c}" data-pid="${S.pid}">
    <div class="ig-h"><span class="pav" style="background:${CATS[c].color}">${initials(p[0])}</span>
      <span class="n"><b>${p[0]}</b> <span class="t">· ${AGOS[(idx+loop)%6]}</span>${(typeof p[4]==="object"&&p[4].sub||CATS[c].sub)?`<small>${typeof p[4]==="object"&&p[4].sub||CATS[c].sub}</small>`:""}</span><span class="more" aria-hidden="true">${ICON.more}</span></div>
    <button class="media" type="button" data-like aria-label="Like ${p[0]}'s post">${art(c,p[4],idx+loop)}<span class="bigheart">${ICON.big}</span></button>
    <div class="actions">
      <button class="like" type="button" data-like aria-label="Like">${ICON.heart}</button>
      <span aria-hidden="true">${ICON.comment}</span><span aria-hidden="true">${ICON.share}</span>
      ${c==="learn"&&typeof p[4]!=="object"?`<span class="cdots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>`:""}
      <span class="save" aria-hidden="true">${ICON.save}</span></div>
    <p class="likes" data-likes="${exact(p[2],loop)}">${exact(p[2],loop)} likes</p>
    <p class="cap"><b>${p[0]}</b> ${p[1]}</p>
    <p class="vc">${nC===1?"View 1 comment":`View all ${exact(p[3],loop)} comments`}</p>
    <p class="add">Add a comment...</p>
  </article>`;
}
function loadBatch(){
  if(!S || S.over) return;
  const chosen=[]; for(let i=0;i<3;i++) chosen.push(pickCat(chosen));
  let html = "", hitCaught = false;
  chosen.forEach(c=>{
    html += postHTML(c); S.seen++;
    if(!S.caught && S.seen === CAUGHT_UP_AFTER){
      S.caught = hitCaught = true;
      html += `<div class="caught"><svg viewBox="0 0 72 72" aria-hidden="true"><circle cx="36" cy="36" r="33" fill="none" stroke="var(--pink)" stroke-width="3"/><path d="M22 37l9 9 19-20" fill="none" stroke="var(--pink)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <b>You're all caught up</b><span>You've seen all new posts from the past 3 days.</span><button class="linkbtn" type="button" data-logoff>Close the app</button></div><div class="sugg-h">Suggested posts</div>`;
    }
  });
  $("feed").insertAdjacentHTML("beforeend", html);
  $$("#feed .ig:not([data-obs])").forEach(a=>{ a.dataset.obs = "1"; vis.observe(a); });
  if(S.seen > 6 && Math.random() < .2) setDot(true);
  if(hitCaught) setTimeout(()=>newTrick("caught"), 1500);
}

function like(article){
  if(S.over || article.classList.contains("liked")) return;
  article.classList.add("liked","pop");
  setTimeout(()=>article.classList.remove("pop"), 800);
  const L = article.querySelector(".likes"), n = parseInt(L.dataset.likes.replace(/,/g,""),10);
  L.textContent = `${(n+1).toLocaleString("en-US")} likes`;
  const c = article.dataset.cat;
  const repeats = S.history.filter(x=>x===c).length;
  const fx = CATS[c].fx, mul = Math.max(.35, 1 - repeats*.18);
  for(const k in fx) S.stats[k] = clamp(S.stats[k] + (k==="dopa" && fx[k]>0 ? fx[k]*mul : fx[k]));
  S.weights[c] += 1.6; S.history.push(c); S.tricks++;
  if(repeats>=2 && !S.seenTricks.has("echo")){ S.seenTricks.add("echo"); setTrick(EXTRA_TRICKS.echo); }
  else setTrick(CATS[c].tip);
  if(Math.random() < .55){ setDot(true); if(S.history.length>=3 && !S.seenTricks.has("notif")) setTimeout(()=>newTrick("notif"), 4200); }
  renderAll();
  if(S.history.length >= LIKES_TO_FINISH){ S.over = true; setTimeout(()=>finish("likes"), 1100); }
}

function resultKey(s, reason){
  if(reason==="logoff" && S.secs < 90) return "limited";
  const b = START_LEVELS;
  const scores = {dopa:(s.dopa-b.dopa-5)*.75, dep:(s.dep-b.dep)*.55, anx:(s.anx-b.anx)*.8, proc:(s.proc-b.proc)*.6, mood:(b.mood-s.mood)*1.25};
  const top = Object.keys(scores).sort((a,c)=>scores[c]-scores[a])[0];
  return scores[top] < 6 ? "limited" : top;
}
function finish(reason){
  S.over = true;
  const s = S.stats, key = resultKey(s, reason), R = RESULTS[key], C = CREWBY[R.crew], on = S.minutes - START;
  GROUP.push({name:S.name, key, minutes:on, secs:S.secs, seen:S.seen, likes:S.history.length}); saveGroup();
  $("resWho").textContent = `${S.name}'s brain result`;
  $("resAv").innerHTML = figure(C.id, R.face, C.color, true);
  $("resChem").innerHTML = key==="limited" ? `Logged off` : `${C.chem} <span class="pill" style="background:${C.color}">${R.level}</span>`;
  $("takeaway").textContent = TAKEAWAY;
  $("resTag").textContent = R.tag;
  const early = S.history.length < LIKES_TO_FINISH ? ` You logged off after ${S.history.length} like${S.history.length===1?"":"s"}.` : "";
  const why = reason==="time" ? ` Time ran out at ${fmt(S.minutes)}.` : "";
  $("resText").textContent = `${R.text} You scrolled for ${clock(S.secs)} of real time (until ${fmt(S.minutes)} on the clock) and saw ${S.seen} posts.${why}${reason==="time"?"":early}`;
  $("finals").innerHTML = CREW.map(c=>{ const v = Math.round(s[c.id]); return `<div class="final"><span class="av">${figure(c.id,mood(c.id,v),c.color,true)}</span><b>${v}</b><span>${c.chem}</span></div>`; }).join("");
  const counts = {}; S.history.forEach(c=>counts[c]=(counts[c]||0)+1);
  const keys = Object.keys(counts).sort((a,b)=>counts[b]-counts[a]);
  $("bubble").innerHTML = keys.length ? keys.map(k=>`<i style="flex:${counts[k]};background:${CATS[k].color}"></i>`).join("") : `<i style="flex:1;background:var(--elev)"></i>`;
  $("legend").innerHTML = keys.length ? keys.map(k=>`<span style="--c:${CATS[k].color}">${CATS[k].label} × ${counts[k]}</span>`).join("") : "<span>You didn't like anything.</span>";
  renderActivity();
  show("resV"); $("nextP").focus();
}

function show(id){ ["startV","resV","grpV"].forEach(v=>$(v).hidden = v!==id); }
function hideAll(){ ["startV","resV","grpV"].forEach(v=>$(v).hidden = true); }
function openStart(){
  $("startEb").textContent = `Player ${GROUP.length+1}`;
  $("startGroup").hidden = GROUP.length === 0;
  $("pname").value = "";
  show("startV"); setTimeout(()=>$("pname").focus(), 30);
}
function g_label(R){ return R===RESULTS.limited ? "Logged off" : `${CREWBY[R.crew].chem} ${R.level.toLowerCase()}`; }
function openGroup(){
  const n = GROUP.length;
  $("grpN").textContent = `${n} player${n===1?"":"s"}`;
  const counts = {}; GROUP.forEach(g=>counts[g.key]=(counts[g.key]||0)+1);
  $("tally").innerHTML = n ? Object.keys(RESULTS).filter(k=>counts[k]).sort((a,b)=>counts[b]-counts[a]).map(k=>{
    const R = RESULTS[k], C = CREWBY[R.crew];
    return `<div class="tal"><span class="av">${figure(C.id, R.face, C.color, true)}</span><b>${counts[k]}</b><span>${g_label(R)}<br>${R.tag}</span></div>`;
  }).join("") : `<div class="tal"><span>No one has played yet.</span></div>`;
  $("plist").innerHTML = GROUP.map(g=>{
    const R = RESULTS[g.key], C = CREWBY[R.crew];
    return `<div class="row"><span class="av">${figure(C.id, R.face, C.color, true)}</span>
      <div class="txt"><b>${esc(g.name)}</b><span>${g_label(R)} · ${R.tag}</span></div><span class="when">${g.secs!=null?clock(g.secs):dur(g.minutes)} · ${g.seen} posts</span></div>`;
  }).join("");
  $("grpClear").textContent = "Clear group results";
  show("grpV");
}

$("startF").addEventListener("submit", e=>{ e.preventDefault(); const nm = $("pname").value.trim(); hideAll(); newGame(nm); });
$("startGroup").addEventListener("click", openGroup);
$("nextP").addEventListener("click", openStart);
$("resGroup").addEventListener("click", openGroup);
$("openGroup").addEventListener("click", openGroup);
$("grpNext").addEventListener("click", openStart);
$("grpClose").addEventListener("click", ()=>{ if(S && S.over) openStart(); else hideAll(); });
$("grpClear").addEventListener("click", e=>{
  if(e.currentTarget.textContent !== "Tap again to clear"){ e.currentTarget.textContent = "Tap again to clear"; return; }
  GROUP = []; saveGroup(); renderActivity(); openGroup();
});
document.addEventListener("click", e=>{
  if(e.target.closest("[data-logoff]")){ if(S && !S.over){ S.over = true; finish("logoff"); } return; }
  const b = e.target.closest("[data-like]"); if(b && S) like(b.closest(".ig"));
});

/* infinite scroll: load more whenever the spinner gets close to the screen */
/* which posts are actually on screen right now */
const onScreen = new Set();
const vis = new IntersectionObserver(entries=>{
  entries.forEach(en=>{ if(en.isIntersecting) onScreen.add(en.target); else onScreen.delete(en.target); });
}, {threshold:.6});

/* the timer: every real second on the app changes your brain, even if you never tap anything */
function paused(){ return !S || S.over || document.hidden || !$("startV").hidden || !$("resV").hidden || !$("grpV").hidden; }
setInterval(()=>{
  if(paused()) return;
  S.secs++; S.minutes = START + S.secs;
  const st = S.stats;
  st.dep  = clamp(st.dep + PASSIVE.dependency);
  st.proc = clamp(st.proc + PASSIVE.procrastination);
  st.mood = clamp(st.mood + PASSIVE.mood);
  st.dopa = clamp(st.dopa + PASSIVE.dopamine);
  onScreen.forEach(a=>{
    if(a.classList.contains("liked")) return;
    const id = a.dataset.pid, c = a.dataset.cat, d = S.dwell[id] = (S.dwell[id]||0) + 1;
    if(d <= PASSIVE.lookMax){
      const fx = CATS[c].fx;
      for(const k in fx) st[k] = clamp(st[k] + fx[k]*PASSIVE.lookShare);
      S.weights[c] += .2;                      // the feed learns from what you look at, too
    }
    if(d === 3) newTrick("dwell");
  });
  if(Math.random() < .04) setDot(true);
  renderCrew(); renderActivity();
  if(S.secs % 5 === 0) renderStories();
  if(S.secs >= MAX_SECONDS){ S.over = true; finish("time"); }
}, 1000);

const io = new IntersectionObserver(entries=>{
  if(entries.some(en=>en.isIntersecting) && S && !S.over){
    loadBatch(); renderActivity();
    requestAnimationFrame(()=>{ io.unobserve($("sentinel")); io.observe($("sentinel")); });
  }
}, {rootMargin:"0px 0px 900px 0px"});

$("srcList").innerHTML = Object.values(SOURCES).map(x=>`<li><a href="${x.url}" target="_blank" rel="noopener">${x.title}</a></li>`).join("");
newGame("");       // a live feed sits behind the start screen
openStart();
io.observe($("sentinel"));
</script>

