  if(P.k==="poll"){ const top = Math.max(...P.opts.map(o=>o[1]));
    return `<div class="art shot" ${bg}><div class="sc poll"><b class="q">${P.q}</b>${P.opts.map(([l,v])=>`<div class="opt${v===top?" win":""}"><i style="width:${v}%"></i><span>${l}</span><em>${v}%</em></div>`).join("")}<small>${P.foot}</small></div></div>`; }
