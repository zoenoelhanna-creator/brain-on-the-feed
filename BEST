const clamp = v => Math.max(0, Math.min(100, v));
function fmt(m){ m %= 24*60; let h = Math.floor(m/60), mm = m%60, ap = h>=12?"PM":"AM"; h = h%12||12; return `${h}:${String(mm).padStart(2,"0")} ${ap}`; }
function clock(sec){ return `${Math.floor(sec/60)}:${String(sec%60).padStart(2,"0")}`; }
function dur(m){ const h = Math.floor(m/60); return h ? `${h}h ${m%60}m` : `${m}m`; }
function exact(s, salt){ return /K$/.test(s) ? Math.round(parseFloat(s)*1000 + ((s.length+salt)*137)%97).toLocaleString("en-US") : s; }
function initials(h){ return h.replace(/[^a-z]/gi,"").slice(0,2).toUpperCase(); }
function esc(s){ return String(s).replace(/[&<>"]/g, ch=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[ch])); }
function setDot(on){ $$("[data-dot]").forEach(d=>d.hidden=!on); }

