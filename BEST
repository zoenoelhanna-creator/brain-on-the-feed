<script>
/* ===== EDIT HERE: everything below comes from our Research Documentation ===== */
const SOURCES = {
  1:{title:"Social Media Algorithms and Teen Addiction: Neurophysiological Impact and Ethical Considerations", url:"https://pmc.ncbi.nlm.nih.gov/articles/PMC11804976/"},
  2:{title:"Are Algorithms Harming Our Relationships?", url:"https://www.psychologytoday.com/us/blog/beyond-mental-health/202404/are-algorithms-harming-our-relationships/amp"},
  3:{title:"Social Media Algorithms and Mental Health", url:"https://acp-mn.com/about-acp/blog/social-media-algorithms-and-mental-health/"}
};
const LIKES_TO_FINISH = 10;
const MAX_SECONDS = 180;          // real seconds of scrolling before time runs out (1 second = 1 minute on the clock)
const PASSIVE = {                 // what happens every real second on the app, even without liking anything
  dependency: 0.15,               //   repeated checking builds dependency (Source 3)
  procrastination: 0.14,          //   ...and procrastination (Source 3)
  mood: -0.06,                    //   ...and low mood (Source 3)
  dopamine: -0.12,                //   slow comedown, so you want the next hit
  lookShare: 0.07,                // each second a post is on screen, you get this share of its effect...
  lookMax: 4                      // ...for up to this many seconds per post
};
/* The five meters are the effects Source 3 names: "dopamine surges ... dependency, anxiety, procrastination, and low mood." */
const CREW = [
  {id:"dopa", chem:"Dopamine", color:"var(--pink)",
   says:{wired:"one more. just one more.", good:"ooh, that was fun!", low:"bored. need a new hit."}},
  {id:"dep", chem:"Dependency", color:"var(--purple)",
   says:{good:"I could put it down anytime.", mid:"just checking one more time...", bad:"can't. stop. checking."}},
  {id:"anx", chem:"Anxiety", color:"var(--orange)",
   says:{good:"all calm over here.", mid:"wait, why is everyone so mad?", bad:"everything feels urgent"}},
  {id:"proc", chem:"Procrastination", color:"var(--blue)",
   says:{good:"essay's due tomorrow. I'm on it.", mid:"I'll start in five minutes.", bad:"what essay?"}},
  {id:"mood", chem:"Mood", color:"var(--teal)",
   says:{good:"feeling pretty good.", mid:"meh.", bad:"why do I feel worse?"}}
];
const START_LEVELS = {dopa:50, dep:10, anx:25, proc:15, mood:65};
/* the six possible results */
const RESULTS = {
  dopa:{crew:"dopa", level:"SURGE", face:"wired", tag:"Chasing the next hit",
    text:"Every tap was a quick reward, and your brain wanted the next one more than it enjoyed the last. Algorithmic rewards trigger dopamine surges that keep you checking."},
  dep:{crew:"dep", level:"HIGH", face:"bad", tag:"Hooked on the loop",
    text:"The feed learned what keeps you here and kept serving it. That feedback loop is how AI-driven content promotes social media addiction."},
  anx:{crew:"anx", level:"HIGH", face:"bad", tag:"Wound up",
    text:"The algorithm boosted emotionally charged posts because they kept you engaged, and you left more anxious than when you opened the app."},
  proc:{crew:"proc", level:"HIGH", face:"bad", tag:"\"Five more minutes\"",
    text:"Nothing dramatic happened, but the scroll never ended. Infinite scroll and notifications kept you checking instead of doing what you meant to do."},
  mood:{crew:"mood", level:"LOW", face:"bad", tag:"Scrolled into a slump",
    text:"You opened the app to feel better and closed it feeling worse. Repeated checking can foster low mood."},
  limited:{crew:"mood", level:"OK", face:"good", tag:"You put it down",
    text:"You limited your time on the feed, and your brain is better for it. In one experiment, five weeks off Facebook or Instagram improved well-being and reduced anxiety and depression."}
};
const TAKEAWAY = "Limiting use is the best way to lower the negative effects of algorithms on the brain.";

/* fx = what liking one post does to each meter. tip = [title, explanation, source number] */
const CATS = {
  outrage:{label:"Outrage", color:"var(--orange)", sub:"Suggested for you", fx:{dopa:8,anx:12,mood:-6,dep:3,proc:2},
    tip:["Emotionally charged posts win","Algorithms boost emotionally charged posts. Anger gets more reactions, so the feed shows you more of it.",3]},
  cute:{label:"Funny/cute", color:"var(--pink)", sub:"Suggested for you", fx:{dopa:9,mood:3,dep:4,proc:3},
    tip:["Algorithmic rewards","Every funny post is a little reward. Algorithmic rewards drive repeated checking and trigger dopamine surges, which can build dependency.",3]},
  compare:{label:"Ads & influencers", color:"var(--gold)", sub:"Paid partnership", fx:{dopa:7,anx:5,mood:-8,dep:3,proc:2},
    tip:["You're the product","Sponsored posts are how the feed makes money. In 2022 alone, US kids and teens generated $11 billion in ad revenue for major social media platforms.",1]},
  friends:{label:"Friends", color:"var(--teal)", sub:"", fx:{dopa:4,mood:8,anx:-4,dep:1,proc:1},
    tip:["Algorithms and relationships","Researchers are asking whether algorithms are harming our relationships. In one six-year study, 28% of people surveyed were estranged from a sibling at some point.",2]},
  brainrot:{label:"Brain rot", color:"var(--lime)", sub:"Suggested for you", fx:{dopa:12,dep:5,proc:5,mood:-2},
    tip:["Dopamine surges","Fast, random clips are the quickest reward on the feed. Those rewards trigger dopamine surges, and repeated checking can foster dependency.",3]},
  learn:{label:"Learning", color:"var(--blue)", sub:"Suggested for you", fx:{dopa:3,mood:2,dep:1,proc:2},
    tip:["Still scrolling","Even useful posts keep you on the app. Infinite scroll and algorithmic rewards drive repeated checking, which can lead to procrastination.",3]}
};
const EXTRA_TRICKS = {
  scroll:["Infinite scroll","The feed never ends, so there's no natural place to stop. Infinite scroll is one of the features that drives repeated checking.",3],
  caught:["The end that isn't","The app said you're all caught up, then kept going with suggested posts. The stopping point was there, and the feed made it easy to scroll right past it.",3],
  dwell:["Feedback loop","You didn't like that post, but the feed noticed you paused on it. AI-driven content optimization creates a feedback loop that promotes social media addiction among teens.",1],
  notif:["Notifications","A red dot keeps showing up. Notifications pull you back to check again, even when nothing important happened.",3],
  echo:["Echo chamber","The feed keeps showing you more of what you already like. Algorithms lead us to media that reinforces what we already believe and steer us into siloed communities, which leads to groupthink.",2]
